{
  "name": "@loktin/sdk",
  "version": "0.2.0",
  "description": "Headless TypeScript SDK for Loktin's Target Savings and Spend & Save contracts on Stellar",
  "keywords": [
    "stellar",
    "soroban",
    "savings",
    "sdk"
  ],
  "homepage": "https://github.com/Lokt-In/loktin-sdk/tree/main/packages/sdk#readme",
  "bugs": "https://github.com/Lokt-In/loktin-sdk/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lokt-In/loktin-sdk.git",
    "directory": "packages/sdk"
  },
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./target-savings": {
      "types": "./dist/target-savings/index.d.ts",
      "default": "./dist/target-savings/index.js"
    },
    "./spend-save": {
      "types": "./dist/spend-save/index.d.ts",
      "default": "./dist/spend-save/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json && tsc -p e2e/tsconfig.json"
  },
  "devDependencies": {
    "@stellar/stellar-sdk": "17.2.1"
  },
  "peerDependencies": {
    "@stellar/stellar-sdk": "^17.2.1"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  }
}
