{
  "name": "loktin-sdk",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces",
    "build": "npm run build --workspaces",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "bash scripts/e2e.sh",
    "sizing:keeper": "bash scripts/keeper-sizing.sh",
    "sizing:reads": "bash scripts/read-overhead.sh",
    "size:check": "node scripts/bundle-size.mjs --check",
    "size:update": "node scripts/bundle-size.mjs --update"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "rolldown": "1.2.14",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
